<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iqDriver</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #121212;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* Container ala HP */
        .app-container {
            width: 100%;
            max-width: 420px;
            height: 100vh;
            max-height: 850px;
            background-color: #181818;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(0,0,0,0.8);
        }

        @media(min-width: 421px) {
            .app-container {
                border-radius: 24px;
                border: 8px solid #333;
            }
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            background-color: #181818;
            z-index: 10;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .menu-btn, .settings-btn {
            background: none;
            border: none;
            color: #fff;
            font-size: 20px;
            cursor: pointer;
        }

        .status-pill {
            background-color: #2b2b2b;
            border-radius: 20px;
            padding: 4px;
            display: flex;
            align-items: center;
            width: 110px;
            justify-content: flex-end;
            position: relative;
            cursor: pointer;
        }

        .status-pill .online-text {
            position: absolute;
            left: 14px;
            font-size: 12px;
            font-weight: bold;
            color: #000;
        }

        .status-pill .pill-badge {
            background-color: #ccff00;
            color: #000;
            padding: 6px 14px;
            border-radius: 16px;
            font-size: 12px;
            font-weight: bold;
        }

        /* Banner Saldo */
        .balance-banner {
            background-color: #242424;
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
            cursor: pointer;
            z-index: 10;
        }

        .balance-banner span {
            color: #ccc;
        }

        .balance-banner i {
            color: #888;
        }

        /* Content Area */
        .content {
            flex: 1;
            position: relative;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        /* Tab 1: Radar / Permintaan */
        .tab-content {
            display: none;
            flex: 1;
            flex-direction: column;
            position: relative;
        }

        .tab-content.active {
            display: flex;
        }

        /* Radar View */
        .radar-view {
            flex: 1;
            position: relative;
            background-color: #121212;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .radar-circle {
            position: absolute;
            width: 300px;
            height: 300px;
            border: 1px solid rgba(204, 255, 0, 0.15);
            border-radius: 50%;
        }

        .radar-circle.c2 { width: 220px; height: 220px; }
        .radar-circle.c3 { width: 140px; height: 140px; }
        .radar-circle.c4 { width: 60px; height: 60px; }

        .radar-center-dot {
            width: 12px;
            height: 12px;
            background-color: #ccff00;
            border-radius: 50%;
            z-index: 2;
            box-shadow: 0 0 10px #ccff00;
        }

        .radar-sweep {
            position: absolute;
            width: 150px;
            height: 150px;
            background: linear-gradient(45deg, rgba(204,255,0,0.4) 0%, transparent 70%);
            top: calc(50% - 150px);
            left: calc(50% - 150px);
            transform-origin: bottom right;
            animation: sweep 4s linear infinite;
            border-top-left-radius: 100%;
        }

        @keyframes sweep {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .radar-text {
            position: absolute;
            top: 40px;
            width: 100%;
            text-align: center;
            font-size: 15px;
            color: #ddd;
            font-weight: 500;
            z-index: 3;
            padding: 0 20px;
        }

        /* Order List View */
        .order-list {
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .order-card {
            background-color: #222;
            border-radius: 12px;
            padding: 14px;
            position: relative;
        }

        .order-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

        .order-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #444;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 12px;
            overflow: hidden;
        }

        .order-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .order-user-info {
            flex: 1;
        }

        .order-user-name {
            font-size: 14px;
            font-weight: bold;
        }

        .order-rating {
            font-size: 12px;
            color: #aaa;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .order-rating i {
            color: #ffc107;
            font-size: 10px;
        }

        .order-distance {
            font-size: 12px;
            color: #888;
        }

        .order-price {
            font-size: 20px;
            font-weight: bold;
            color: #fff;
            margin-bottom: 6px;
        }

        .order-route {
            font-size: 13px;
            color: #ccc;
            line-height: 1.4;
        }

        .order-route .dest {
            color: #999;
            font-size: 12px;
        }

        .order-options-btn {
            position: absolute;
            top: 14px;
            right: 14px;
            background: none;
            border: none;
            color: #888;
            font-size: 16px;
            cursor: pointer;
        }

        /* Tab 2: Performa */
        .performa-container {
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .performa-header-title {
            font-size: 22px;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .performa-header-title span {
            font-size: 14px;
            color: #888;
            font-weight: normal;
        }

        .performa-card {
            background-color: #222;
            border-radius: 12px;
            padding: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
        }

        .performa-card-left h3 {
            font-size: 18px;
            margin-bottom: 4px;
        }

        .performa-card-left p {
            font-size: 13px;
            color: #888;
        }

        .earnings-amount {
            font-size: 24px;
            font-weight: bold;
            margin: 8px 0;
        }

        .btn-target {
            background-color: #2a2a2a;
            color: #fff;
            border: none;
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
        }

        /* Bottom Navigation */
        .bottom-nav {
            display: flex;
            background-color: #181818;
            border-top: 1px solid #282828;
            height: 60px;
        }

        .nav-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: none;
            border: none;
            color: #777;
            font-size: 11px;
            cursor: pointer;
            gap: 4px;
        }

        .nav-item.active {
            color: #fff;
        }

        .nav-item i {
            font-size: 18px;
        }

        /* Sidebar / Drawer Menu */
        .sidebar {
            position: absolute;
            top: 0;
            left: -100%;
            width: 85%;
            height: 100%;
            background-color: #1f1f1f;
            z-index: 100;
            transition: 0.3s ease;
            display: flex;
            flex-direction: column;
            box-shadow: 5px 0 15px rgba(0,0,0,0.5);
        }

        .sidebar.open {
            left: 0;
        }

        .sidebar-header {
            padding: 20px 16px;
            border-bottom: 1px solid #333;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sidebar-profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            overflow: hidden;
            background-color: #444;
        }

        .sidebar-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .sidebar-name h3 {
            font-size: 16px;
            margin-bottom: 2px;
        }

        .sidebar-name .rating {
            font-size: 12px;
            color: #aaa;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .sidebar-name .rating i {
            color: #ffc107;
        }

        .sidebar-menu {
            flex: 1;
            overflow-y: auto;
            padding: 10px 0;
        }

        .sidebar-item {
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            color: #ddd;
            font-size: 15px;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
        }

        .sidebar-item i {
            font-size: 18px;
            color: #aaa;
            width: 24px;
            text-align: center;
        }

        .sidebar-footer {
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            border-top: 1px solid #333;
        }

        .mode-pengemudi-btn {
            background-color: #ccff00;
            color: #000;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
            text-align: center;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            gap: 24px;
            color: #aaa;
            font-size: 20px;
        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.6);
            z-index: 90;
            display: none;
        }

        .overlay.show {
            display: block;
        }
    </style>
</head>
<body>

<div class="app-container">
    
    <!-- Sidebar / Menu Drawer -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-profile">
                <div class="sidebar-avatar">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100" alt="Helmi">
                </div>
                <div class="sidebar-name">
                    <h3>Helmi</h3>
                    <div class="rating">
                        <i class="fa-solid fa-star"></i> 5.00 (0)
                    </div>
                </div>
            </div>
            <i class="fa-solid fa-chevron-right" style="color: #777; font-size: 14px;"></i>
        </div>
        <div class="sidebar-menu">
            <button class="sidebar-item"><i class="fa-solid fa-car"></i> Kota</button>
            <button class="sidebar-item"><i class="fa-solid fa-clock-rotate-left"></i> Riwayat permintaan</button>
            <button class="sidebar-item"><i class="fa-solid fa-box"></i> Kurir</button>
            <button class="sidebar-item"><i class="fa-solid fa-globe"></i> Antarkota</button>
            <button class="sidebar-item"><i class="fa-solid fa-bell"></i> Notifikasi</button>
            <button class="sidebar-item"><i class="fa-solid fa-shield-halved"></i> Keselamatan</button>
            <button class="sidebar-item"><i class="fa-solid fa-gear"></i> Pengaturan</button>
            <button class="sidebar-item"><i class="fa-solid fa-circle-info"></i> Bantuan</button>
            <button class="sidebar-item"><i class="fa-solid fa-comment-dots"></i> Dukungan</button>
        </div>
        <div class="sidebar-footer">
            <button class="mode-pengemudi-btn">Mode pengemudi</button>
            <div class="social-icons">
                <i class="fa-brands fa-whatsapp"></i>
                <i class="fa-brands fa-facebook-f"></i>
                <i class="fa-brands fa-instagram"></i>
            </div>
        </div>
    </div>
    <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

    <!-- Header Aplikasi -->
    <div class="header">
        <div class="header-left">
            <button class="menu-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
            <div class="status-pill" onclick="toggleStatus()">
                <span class="online-text" id="statusText">Online</span>
                <div class="pill-badge" id="statusBadge">Online</div>
            </div>
        </div>
        <button class="settings-btn"><i class="fa-solid fa-gear"></i></button>
    </div>

    <!-- Banner Saldo Kurang -->
    <div class="balance-banner">
        <div>Saldo kurang. Tambah dana</div>
        <i class="fa-solid fa-chevron-right"></i>
    </div>

    <!-- Area Konten Utama -->
    <div class="content">
        
        <!-- Tab 1: Permintaan Transportasi (Radar + List Order) -->
        <div class="tab-content active" id="tab-transport">
            <!-- Tampilan Radar (Default jika belum ada order/bisa di-scroll) -->
            <div class="radar-view" style="height: 380px; flex: none;">
                <div class="radar-text">Tunggu, order akan segera muncul di sini...</div>
                <div class="radar-circle c1"></div>
                <div class="radar-circle c2"></div>
                <div class="radar-circle c3"></div>
                <div class="radar-circle c4"></div>
                <div class="radar-sweep"></div>
                <div class="radar-center-dot"></div>
            </div>

            <!-- Daftar Order Masuk (Mirip Screenshot 2) -->
            <div class="order-list">
                <div class="order-card">
                    <button class="order-options-btn"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                    <div class="order-header">
                        <div class="order-avatar">
                            <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100" alt="Dhea">
                        </div>
                        <div class="order-user-info">
                            <div class="order-user-name">Dhea</div>
                            <div class="order-rating"><i class="fa-solid fa-star"></i> 5.0 (778) <span class="order-distance">• ~5,1 km</span></div>
                        </div>
                    </div>
                    <div class="order-price">Rp12.900</div>
                    <div class="order-route">
                        PT Gelindo Garmentama (Cakuang Kulon, Bandung Regency, West Java)<br>
                        <span class="dest">Jl. Kulalet</span>
                    </div>
                </div>

                <div class="order-card">
                    <button class="order-options-btn"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                    <div class="order-header">
                        <div class="order-avatar">
                            <i class="fa-solid fa-user" style="color: #888;"></i>
                        </div>
                        <div class="order-user-info">
                            <div class="order-user-name">Lisna</div>
                            <div class="order-rating"><i class="fa-solid fa-star"></i> 4.79 (107) <span class="order-distance">• ~8,4 km</span></div>
                        </div>
                    </div>
                    <div class="order-price">Rp8.800</div>
                    <div class="order-route">
                        Jl. Moch. Toha<br>
                        <span class="dest">Jongko 67 KUE BALOK & KOPI (Jl. Moch. Toha, Ciseureuh, Kota Bandung, Jawa Barat)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: Performa -->
        <div class="tab-content" id="tab-performa">
            <div class="performa-container">
                <div class="performa-header-title">
                    Rendah <i class="fa-solid fa-circle-question" style="font-size: 16px; color: #888;"></i>
                    <span style="display: block; width: 100%; font-size: 12px; color: #888; margin-top: -4px;">Prioritas</span>
                </div>

                <div class="performa-card">
                    <div class="performa-card-left">
                        <h3>5.00 <i class="fa-solid fa-star" style="color: #ffc107; font-size: 14px;"></i></h3>
                        <p>Peringkat</p>
                    </div>
                    <i class="fa-solid fa-chevron-right" style="color: #777;"></i>
                </div>

                <div class="performa-card" style="flex-direction: column; align-items: flex-start; gap: 10px;">
                    <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                        <p style="color: #888; font-size: 13px;">Pendapatan hari ini</p>
                        <i class="fa-solid fa-chevron-right" style="color: #777; font-size: 14px;"></i>
                    </div>
                    <div class="earnings-amount">Rp0</div>
                    <button class="btn-target">
                        <i class="fa-solid fa-plus"></i> Tambahkan target harian
                    </button>
                </div>

                <div class="performa-card">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <i class="fa-solid fa-wallet" style="font-size: 20px;"></i>
                        <div>
                            <div style="font-size: 14px; font-weight: bold;">Rp4.463,75</div>
                            <div style="font-size: 12px; color: #888;">Saldo dompet</div>
                        </div>
                    </div>
                    <button style="background-color: #333; color: #fff; border: none; padding: 6px 14px; border-radius: 16px; font-size: 12px; font-weight: bold; cursor: pointer;">Isi ulang</button>
                </div>

                <div class="performa-card">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <i class="fa-solid fa-compass" style="font-size: 20px;"></i>
                        <div>
                            <div style="font-size: 14px; font-weight: bold;">0</div>
                            <div style="font-size: 12px; color: #888;">Bonus</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-right" style="color: #777;"></i>
                </div>

                <div class="performa-card">
                    <div class="performa-card-left">
                        <h3>Pencapaian</h3>
                    </div>
                    <i class="fa-solid fa-chevron-right" style="color: #777;"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Bottom Navigation -->
    <div class="bottom-nav">
        <button class="nav-item active" onclick="switchTab('transport', this)">
            <i class="fa-solid fa-bars-staggered"></i>
            <span>Permintaan transportasi</span>
        </button>
        <button class="nav-item" onclick="switchTab('performa', this)">
            <i class="fa-solid fa-border-all"></i>
            <span>Performa</span>
        </button>
    </div>

</div>

<script>
    // Fungsi Ganti Tab
    function switchTab(tabName, element) {
        document.querySelectorAll('.tab-content').forEach(tab => {
            tab.classList.remove('active');
        });
        document.querySelectorAll('.nav-item').forEach(nav => {
            nav.classList.remove('active');
        });

        if(tabName === 'transport') {
            document.getElementById('tab-transport').classList.add('active');
        } else if(tabName === 'performa') {
            document.getElementById('tab-performa').classList.add('active');
        }
        element.classList.add('active');
    }

    // Fungsi Toggle Sidebar Drawer
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        sidebar.classList.toggle('open');
        overlay.classList.toggle('show');
    }

    // Fungsi Toggle Status Online/Offline
    let isOnline = true;
    function toggleStatus() {
        isOnline = !isOnline;
        const text = document.getElementById('statusText');
        const badge = document.getElementById('statusBadge');
        if(isOnline) {
            text.innerText = "Online";
            badge.innerText = "Online";
            badge.style.backgroundColor = "#ccff00";
            text.style.color = "#000";
        } else {
            text.innerText = "Offline";
            badge.innerText = "Offline";
            badge.style.backgroundColor = "#444";
            text.style.color = "#fff";
        }
    }
</script>

</body>
</html>
